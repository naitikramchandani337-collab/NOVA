DATABASE_URL=sqlite:///./nova.db
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://YOUR_FRONTEND_DOMAIN.vercel.app"]

ENVIRONMENT=production
DEBUG=false

# Use either OpenRouter or Groq. OpenRouter is preferred when both are set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-3.5-turbo
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

API_HOST=0.0.0.0
API_PORT=8000
