rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Progress — only owner
    match /progress/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Settings — only owner
    match /settings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Capstone — only owner
    match /capstone/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Friends — authenticated users
    match /friends/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Friend requests
    match /friendRequests/{docId} {
      allow read: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow update: if request.auth != null && resource.data.to == request.auth.uid;
    }

    // Activities — readable by friends
    match /activities/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Notifications — only recipient
    match /notifications/{docId} {
      allow read, write: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null;
    }
  }
}
